#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if ! command -v python3 >/dev/null 2>&1 || ! python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 12) else 1)'; then
  echo "[vibeos] Python 3.12 or newer is required. Put a supported python3 on PATH before installing." >&2
  exit 2
fi
exec python3 "$SCRIPT_DIR/plugins/vibeos/scripts/profile_install.py" "$@"
