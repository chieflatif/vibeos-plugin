{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VibeOS Work Order Frontmatter",
  "description": "Machine-readable Work Order contract used by VibeOS generators for scope, auditors, model policy, budget posture, loop ceilings, and no-touch boundaries.",
  "type": "object",
  "required": [
    "wo",
    "title",
    "status",
    "phase",
    "phase_name",
    "wo_class",
    "write_scope",
    "no_touch",
    "required_auditors",
    "model_policy",
    "budget_posture"
  ],
  "additionalProperties": false,
  "properties": {
    "wo": {
      "type": "string",
      "pattern": "^WO-[0-9]{3}[a-z]?$",
      "description": "Canonical Work Order identifier."
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "description": "Human-readable title without the WO prefix."
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Planned",
        "Active - Phase 0",
        "Internally Audited",
        "Accepted - Awaiting Entry Audit",
        "Implementation Ready",
        "In Progress",
        "Implemented Locally",
        "Awaiting Gate Cleanup",
        "Awaiting Real-Path Verification",
        "Dev-Mode Complete",
        "Awaiting Checkpoint",
        "Awaiting Evidence",
        "Pre-Commit Audit",
        "Complete",
        "Blocked",
        "STALLED_AT_CEILING"
      ],
      "description": "Truthful lifecycle state. Complete requires real-path verification and relevant gates."
    },
    "phase": {
      "type": "integer",
      "minimum": 0,
      "description": "Numeric development-plan phase."
    },
    "phase_name": {
      "type": "string",
      "minLength": 3,
      "description": "Human-readable development-plan phase name."
    },
    "wo_class": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "docs-only",
            "planning",
            "harness",
            "test-only",
            "logic-change",
            "mutation-path",
            "auth-security",
            "dependency",
            "delivery-infrastructure",
            "prompt-agent",
            "release-proof"
          ]
        },
        {
          "type": "string",
          "pattern": "^custom-[a-z0-9][a-z0-9-]*$"
        }
      ],
      "description": "Governance class. Built-in classes are portable; project-local extensions must use custom-*."
    },
    "write_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/path_glob"
      },
      "description": "Path globs this WO may edit. Generators use this for worktree scope manifests and lane readiness."
    },
    "no_touch": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/path_glob"
      },
      "description": "Path globs explicitly forbidden for this WO, even if broad write_scope would otherwise match."
    },
    "required_auditors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "description": "Auditor roles required before completion. Generators feed this into auditor-artifact gates."
    },
    "model_policy": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "drafting",
            "implementation",
            "frontier-audit",
            "dependency-research",
            "cost-sensitive"
          ]
        },
        {
          "type": "string",
          "pattern": "^custom-[a-z0-9][a-z0-9-]*$"
        }
      ],
      "description": "Model/effort tier name. Resolved by plugins/vibeos/reference/model-policy.json, never hardcoded to provider model IDs."
    },
    "budget_posture": {
      "type": "object",
      "required": ["token_ceiling", "turn_ceiling", "cost_ceiling_usd"],
      "additionalProperties": false,
      "properties": {
        "token_ceiling": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "turn_ceiling": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "cost_ceiling_usd": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "notes": {
          "type": "string"
        }
      },
      "description": "Budget ceilings for loops, headless runs, workflow fan-out, and high-cost audits. Null means not yet budgeted."
    },
    "loop_goal": {
      "type": "string",
      "minLength": 3,
      "description": "Optional bounded-loop goal. Required before loop/headless continuation can run for this WO."
    },
    "loop_ceiling_turns": {
      "type": "integer",
      "minimum": 1,
      "description": "Optional explicit turn ceiling for loop execution."
    },
    "loop_ceiling_cost_usd": {
      "type": "number",
      "minimum": 0,
      "description": "Optional explicit cost ceiling for loop execution."
    }
  },
  "definitions": {
    "path_glob": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(^|/)\\.\\.(?:/|$)"
      }
    }
  },
  "x-vibeos-class-defaults": {
    "docs-only": {
      "governance_tier": "light",
      "minimum_required_auditors": ["evidence-auditor"],
      "differential_audit_allowed": true,
      "evidence_depth": "command-and-diff"
    },
    "planning": {
      "governance_tier": "light",
      "minimum_required_auditors": ["plan-auditor", "evidence-auditor"],
      "differential_audit_allowed": true,
      "evidence_depth": "plan-and-proof"
    },
    "harness": {
      "governance_tier": "standard",
      "minimum_required_auditors": ["correctness-auditor", "evidence-auditor"],
      "differential_audit_allowed": true,
      "evidence_depth": "tests-gates-and-proof"
    },
    "test-only": {
      "governance_tier": "standard",
      "minimum_required_auditors": ["test-auditor", "evidence-auditor"],
      "differential_audit_allowed": true,
      "evidence_depth": "test-diff-and-proof"
    },
    "logic-change": {
      "governance_tier": "standard",
      "minimum_required_auditors": ["correctness-auditor", "test-auditor", "evidence-auditor"],
      "differential_audit_allowed": true,
      "evidence_depth": "tests-gates-and-integration-proof"
    },
    "mutation-path": {
      "governance_tier": "deep",
      "minimum_required_auditors": ["correctness-auditor", "security-auditor", "test-auditor", "evidence-auditor"],
      "differential_audit_allowed": false,
      "evidence_depth": "state-mutation-invariant-and-rollback-proof"
    },
    "auth-security": {
      "governance_tier": "deep",
      "minimum_required_auditors": ["security-auditor", "correctness-auditor", "test-auditor", "evidence-auditor"],
      "differential_audit_allowed": false,
      "evidence_depth": "security-boundary-and-negative-test-proof"
    },
    "dependency": {
      "governance_tier": "deep",
      "minimum_required_auditors": ["dependency-intelligence-auditor", "security-auditor", "evidence-auditor"],
      "differential_audit_allowed": false,
      "evidence_depth": "current-source-compatibility-lockfile-and-audit-proof"
    },
    "delivery-infrastructure": {
      "governance_tier": "deep",
      "minimum_required_auditors": ["delivery-infrastructure-auditor", "security-auditor", "evidence-auditor"],
      "differential_audit_allowed": false,
      "evidence_depth": "ci-deploy-observability-smoke-rollback-proof"
    },
    "prompt-agent": {
      "governance_tier": "standard",
      "minimum_required_auditors": ["prompt-engineer", "evidence-auditor"],
      "differential_audit_allowed": true,
      "evidence_depth": "instruction-diff-and-behavior-proof"
    },
    "release-proof": {
      "governance_tier": "deep",
      "minimum_required_auditors": ["evidence-auditor", "security-auditor", "correctness-auditor"],
      "differential_audit_allowed": false,
      "evidence_depth": "tag-install-gate-secret-sample-trace-and-limitation-proof"
    }
  }
}
