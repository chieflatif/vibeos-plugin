# Formula-only subset used by install-macos.sh.
# Casks are handled separately so existing manually installed apps do not
# make a partial new-machine bootstrap fail.

tap "azure/functions"
tap "stripe/stripe-cli"

brew "git"
brew "gh"
brew "jq"
brew "yq"
brew "ripgrep"
brew "fd"
brew "tree"
brew "wget"
brew "node"
brew "uv"
brew "ruff"
brew "mise"
brew "go"
brew "cmake"
brew "azure-cli"
brew "azure/functions/azure-functions-core-tools@4"
brew "render"
brew "stripe/stripe-cli/stripe"
brew "opentofu"
brew "cloudflared"
brew "rclone"
brew "redis"
brew "postgresql@16"
brew "ffmpeg"
brew "imagemagick"
brew "poppler"
brew "pandoc"
